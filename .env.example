FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=data/mentalcare.db
MODEL_PATH=artifacts/models/final_model.joblib
MODEL_VERSION=emotion-sklearn-qwen3-4b-v1
MAX_INPUT_LENGTH=500
LOW_CONFIDENCE_THRESHOLD=0.45
MEDIUM_CONFIDENCE_THRESHOLD=0.70
RETENTION_DAYS=30
FLASK_DEBUG=false
PORT=5000
LLM_PROVIDER=ollama
OLLAMA_MODEL=my-qwen-chatbot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
MEMORY_MESSAGE_LIMIT=6
EMOTION_PROVIDER=sklearn
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
